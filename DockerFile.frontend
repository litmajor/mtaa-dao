
# ---- Build Stage ----
FROM node:22-bullseye-slim AS builder
WORKDIR /app

# Use npm for installs (prefer locked installs, increase network timeouts)
COPY package*.json ./
COPY docs-site/package.json ./docs-site/package.json
# prefer `npm ci` for reproducible installs; increase network timeout and retries
RUN npm ci --prefer-offline --no-audit --progress=false --network-timeout=600000 --fetch-retries=5

COPY . .

# Build the frontend using Vite
RUN npm run build:frontend

# ---- Serve with Nginx ----
FROM nginx:alpine
COPY --from=builder /app/dist/public /usr/share/nginx/html
COPY ./nginx.frontend.conf /etc/nginx/nginx.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
