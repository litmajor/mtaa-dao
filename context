/**
 * Self-custody Onramp: M-Pesa → real cUSD delivered to user's wallet
 * Does NOT credit any internal ledger balance.
 */
static async initiateOnramp(request: OnrampRequest): Promise<OnrampResponse> {
  const referenceId = request.reference || `ONRAMP-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;

  try {
    if (!request.userId || !request.phone || !request.receiverAddress || request.amountKES <= 0) {
      throw new Error('Invalid onramp request');
    }

    // 1. Optional: get rate quote
    const rateRes = await this.kotaniRequest('POST', '/api/v3/rate/onramp', {
      from: 'KES',
      to: 'CUSD',
      fiatAmount: request.amountKES,
      source: 'fiat',
    });

    const rateId = rateRes?.data?.id;
    const estimatedCUSD = Number(rateRes?.data?.cryptoAmount ?? 0);
    const exchangeRate = rateRes?.data?.value ? Number(rateRes.data.value) : undefined;

    // 2. Create onramp
    const payload = {
      fiatAmount: request.amountKES,
      currency: 'KES',
      chain: 'CELO',
      token: 'CUSD',
      receiverAddress: request.receiverAddress,
      referenceId,
      callbackUrl: `${process.env.API_BASE_URL}/api/webhooks/kotani/onramp`,
      rateId,
      mobileMoney: {
        phoneNumber: request.phone,
        accountName: request.accountName || 'MtaaDAO User',
        providerNetwork: 'MPESA',
      },
    };

    const createRes = await this.kotaniRequest('POST', '/api/v3/onramp', payload);

    // 3. Persist local record (do NOT touch user_balances)
    await (db as any).insert(mpesaTransactionsTable).values({
      userId: request.userId,
      phoneNumber: request.phone,
      transactionType: 'onramp',
      amount: request.amountKES.toString(),
      checkoutRequestId: referenceId,
      accountReference: `MtaaDAO-Onramp-${request.userId.substring(0, 8)}`,
      transactionDesc: `Onramp to ${request.receiverAddress}`,
      status: 'pending',
      metadata: {
        type: 'self_custody_onramp',
        referenceId,
        receiverAddress: request.receiverAddress,
        estimatedCUSD,
        exchangeRate,
        daoId: request.daoId,
        kotaniResponse: createRes?.data,
      },
      createdAt: new Date(),
      updatedAt: new Date(),
    });

    return {
      success: true,
      referenceId,
      status: 'pending',
      amountKES: request.amountKES,
      estimatedCUSD,
      exchangeRate,
      message: 'STK Push sent. Enter your M-Pesa PIN. cUSD will be sent to your wallet.',
    };
  } catch (error: any) {
    console.error('initiateOnramp error:', error);
    throw error;
  }
}

/**
 * Self-custody Offramp: user sends cUSD from their wallet → M-Pesa
 * Returns the escrow address the user must send to.
 */
static async initiateOfframp(request: OfframpRequest): Promise<OfframpResponse> {
  const referenceId = request.reference || `OFFRAMP-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;

  try {
    if (!request.userId || !request.phone || !request.senderAddress || request.amountCUSD <= 0) {
      throw new Error('Invalid offramp request');
    }

    // 1. Rate quote
    const rateRes = await this.kotaniRequest('POST', '/api/v3/rate/offramp', {
      from: 'CUSD',
      to: 'KES',
      cryptoAmount: request.amountCUSD,
      source: 'crypto',
    });

    const rateId = rateRes?.data?.id;
    const estimatedKES = Number(rateRes?.data?.fiatAmount ?? 0);
    const exchangeRate = rateRes?.data?.value ? Number(rateRes.data.value) : undefined;

    // 2. Create offramp
    const payload = {
      cryptoAmount: request.amountCUSD,
      currency: 'KES',
      chain: 'CELO',
      token: 'CUSD',
      referenceId,
      callbackUrl: `${process.env.API_BASE_URL}/api/webhooks/kotani/offramp`,
      rateId,
      senderAddress: request.senderAddress,
      mobileMoneyReceiver: {
        phoneNumber: request.phone,
        accountName: request.accountName || 'MtaaDAO User',
        providerNetwork: 'MPESA',
      },
    };

    const createRes = await this.kotaniRequest('POST', '/api/v3/offramp', payload);
    const escrowAddress = createRes?.data?.escrowAddress;

    if (!escrowAddress) {
      throw new Error('No escrow address returned from KotaniPay');
    }

    // 3. Persist local record
    await (db as any).insert(mpesaTransactionsTable).values({
      userId: request.userId,
      phoneNumber: request.phone,
      transactionType: 'offramp',
      amount: request.amountCUSD.toString(),
      checkoutRequestId: referenceId,
      accountReference: `MtaaDAO-Offramp-${request.userId.substring(0, 8)}`,
      transactionDesc: `Offramp from ${request.senderAddress}`,
      status: 'pending',
      metadata: {
        type: 'self_custody_offramp',
        referenceId,
        senderAddress: request.senderAddress,
        escrowAddress,
        estimatedKES,
        exchangeRate,
        daoId: request.daoId,
        kotaniResponse: createRes?.data,
      },
      createdAt: new Date(),
      updatedAt: new Date(),
    });

    return {
      success: true,
      referenceId,
      escrowAddress,
      status: 'pending',
      amountCUSD: request.amountCUSD,
      estimatedKES,
      exchangeRate,
      message: 'Send the exact cUSD amount to the escrow address from your connected wallet.',
    };
  } catch (error: any) {
    console.error('initiateOfframp error:', error);
    throw error;
  }
}

/**
 * Shared helper – replace with whatever HTTP client you already use
 */
private static async kotaniRequest(method: string, path: string, body?: any) {
  const url = `${KOTANI_BASE_URL}${path}`;
  const res = await fetch(url, {
    method,
    headers: {
      'Authorization': `Bearer ${KOTANI_API_KEY}`,
      'Content-Type': 'application/json',
    },
    body: body ? JSON.stringify(body) : undefined,
  });

  const data = await res.json();
  if (!res.ok) {
    throw new Error(data?.message || `KotaniPay error ${res.status}`);
  }
  return data;
}
